{UTF-8}
Inventory= INTEG (Delivery+Restocking-Sales-Wastage,
		12500)
	~	units
	~		|

Backlog= INTEG (Unfulfilled Demand-Backlog Fulfillment,
		0)
	~	units
	~		|

Backlog Fulfillment=MIN( Backlog , Inventory ) / Fulfillment Time
	~	units/Week
	~		|

Capacity Adjustment=( Desired Supplier Capacity - Supplier Capacity )
	/ Capacity Adjustment Time
	~	{units/Week^2}
	~		|

Disposal Time=4
	~	Week
	~		|

Fulfillment Time=1
	~	Week
	~		|

Waste Disposal=Waste Accumulation / Disposal Time
	~	units/Week
	~		|

Sales=MIN(
	    Inventory / Sales Fulfillment Time,
	    Demand + Backlog Fulfillment
	)
	~	units / Week
	~		|

Sales Fulfillment Time=1
	~	Week
	~		|

Desired Supplier Capacity=2
	~	units/Week
	~		|

Unfulfilled Demand=MAX(
	    0,
	    Demand - Sales
	)
	~	units/Week
	~		|

Capacity Adjustment Time=10
	~	Week
	~		|

Customer Returns=Sales * Return Fraction
	~	units / Week
	~		|

Delivery=Pipeline Inventory / Delivery Delay
	~	units / Week
	~		|

Supplier Capacity= INTEG (Capacity Adjustment,
		400)
	~	units / Week
	~		|

Inspection Delay=2
	~	Week
	~		|

Waste Accumulation= INTEG (Wastage - Waste Disposal,
		0)
	~	units
	~		|

Order Rate=MIN(
	  Supplier Capacity,
	  Inventory Gap / Delivery Delay
	)
	~	units / Week
	~		|

Pipeline Inventory= INTEG (Order Rate - Delivery,
		500)
	~	units
	~		|

Restocking=Returned Inventory / Inspection Delay
	~	units / Week
	~		|

Return Fraction=0.05
	~	Dmnl
	~		|

Returned Inventory= INTEG (Customer Returns - Restocking,
		0)
	~	units
	~		|

Wastage Rate=1/Product Life
	~	1 / Week
	~		|

Product Life=20
	~	Week
	~		|

Wastage=Inventory * Wastage Rate
	~	units / Week
	~		|

Delivery Delay=5
	~	Week
	~		|

Demand=200
	~	units / Week
	~		|

Desired Inventory=1200
	~	units
	~		|

Inventory Gap=Desired Inventory - Inventory
	~	units
	~		|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 52
	~	Week
	~	The final time for the simulation.
	|

INITIAL TIME  = 0
	~	Week
	~	The initial time for the simulation.
	|

SAVEPER  = 
        TIME STEP
	~	Week [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP  = 0.25
	~	Week [0,?]
	~	The time step for the simulation.
	|

